{
  "name": "cantonlink-community",
  "version": "1.0.0-rc.2",
  "private": true,
  "description": "Free, open Cantonese learning content: grammar patterns, topic vocabulary and practice in Jyutping, Yale and Bopomofo.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/format.mjs --check && node tools/build.mjs --check && node tools/check-pronunciation.mjs",
    "check:pronunciation": "node tools/check-pronunciation.mjs",
    "gen:simplified": "node tools/gen-simplified.mjs",
    "format": "node tools/format.mjs",
    "test": "node --test \"tools/*.test.mjs\"",
    "romanise": "node tools/cli.mjs",
    "site": "node tools/site.mjs",
    "preview": "node tools/site.mjs --serve",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e.mjs",
    "test:live": "node tests/live-ai.mjs"
  },
  "devDependencies": {
    "opencc-js": "1.4.2",
    "playwright": "1.56.1",
    "to-jyutping": "3.1.1"
  }
}
