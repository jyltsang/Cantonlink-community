{
  "id": "spoken-or-written",
  "title": "Spoken or written?",
  "description": "Each pair says the same thing. The first is Standard Written Chinese; the second is how people actually say it in Cantonese.",
  "items": [
    { "written": "他是學生。", "spoken": [["佢", "keoi5"], ["係", "hai6"], ["學生", "hok6 saang1"], ["。"]], "en": "He's a student.", "changes": "他 → 佢, 是 → 係" },
    { "written": "我不知道。", "spoken": [["我", "ngo5"], ["唔", "m4"], ["知", "zi1"], ["。"]], "en": "I don't know.", "changes": "不 → 唔; 知道 is usually shortened to 知" },
    { "written": "我沒有錢。", "spoken": [["我", "ngo5"], ["冇", "mou5"], ["錢", "cin2"], ["。"]], "en": "I don't have any money.", "changes": "沒有 → 冇" },
    { "written": "你在哪裏？", "spoken": [["你", "nei5"], ["喺", "hai2"], ["邊度", "bin1 dou6"], ["呀", "aa3"], ["？"]], "en": "Where are you?", "changes": "在 → 喺, 哪裏 → 邊度" },
    { "written": "這個多少錢？", "spoken": [["呢", "ni1"], ["個", "go3"], ["幾多錢", "gei2 do1 cin2"], ["呀", "aa3"], ["？"]], "en": "How much is this?", "changes": "這 → 呢, 多少 → 幾多" },
    { "written": "我吃了飯。", "spoken": [["我", "ngo5"], ["食", "sik6"], ["咗", "zo2"], ["飯", "faan6"], ["。"]], "en": "I've eaten.", "changes": "吃 → 食, 了 → 咗" },
    { "written": "他們很好。", "spoken": [["佢哋", "keoi5 dei6"], ["好", "hou2"], ["好", "hou2"], ["。"]], "en": "They're very nice.", "changes": "他們 → 佢哋, 很 → 好" },
    { "written": "這是我的書。", "spoken": [["呢", "ni1"], ["本", "bun2"], ["係", "hai6"], ["我", "ngo5"], ["嘅", "ge3"], ["書", "syu1"], ["。"]], "en": "This is my book.", "changes": "這 → 呢 + classifier, 是 → 係, 的 → 嘅" },
    { "written": "你要甚麼？", "spoken": [["你", "nei5"], ["要", "jiu3"], ["乜嘢", "mat1 je5"], ["呀", "aa3"], ["？"]], "en": "What would you like?", "changes": "甚麼 → 乜嘢" },
    { "written": "我正在工作。", "spoken": [["我", "ngo5"], ["做", "zou6"], ["緊", "gan2"], ["嘢", "je5"], ["。"]], "en": "I'm working.", "changes": "正在 + verb → verb + 緊; 工作 → 做嘢" },
    { "written": "他給了我一本書。", "spoken": [["佢", "keoi5"], ["畀", "bei2"], ["咗", "zo2"], ["一", "jat1"], ["本", "bun2"], ["書", "syu1"], ["我", "ngo5"], ["。"]], "en": "He gave me a book.", "changes": "給 → 畀 (thing before person), 了 → 咗" },
    { "written": "我們走吧。", "spoken": [["我哋", "ngo5 dei6"], ["走", "zau2"], ["啦", "laa1"], ["。"]], "en": "Let's go.", "changes": "我們 → 我哋, 吧 → 啦" },
    { "written": "為甚麼？", "spoken": [["點解", "dim2 gaai2"], ["？"]], "en": "Why?", "changes": "為甚麼 → 點解" },
    { "written": "現在幾點？", "spoken": [["而家", "ji4 gaa1"], ["幾點", "gei2 dim2"], ["呀", "aa3"], ["？"]], "en": "What time is it now?", "changes": "現在 → 而家" },
    { "written": "我不會說廣東話。", "spoken": [["我", "ngo5"], ["唔", "m4"], ["識", "sik1"], ["講", "gong2"], ["廣東話", "gwong2 dung1 waa2"], ["。"]], "en": "I can't speak Cantonese.", "changes": "不會說 → 唔識講" },
    { "written": "他比我高。", "spoken": [["佢", "keoi5"], ["高", "gou1"], ["過", "gwo3"], ["我", "ngo5"], ["。"]], "en": "He's taller than me.", "changes": "A 比 B 高 → A 高過 B" },
    { "written": "他看電視。", "spoken": [["佢", "keoi5"], ["睇", "tai2"], ["電視", "din6 si6"], ["。"]], "en": "He's watching TV.", "changes": "看 → 睇" },
    { "written": "我很喜歡吃點心。", "spoken": [["我", "ngo5"], ["好", "hou2"], ["鍾意", "zung1 ji3"], ["食", "sik6"], ["點心", "dim2 sam1"], ["。"]], "en": "I really like dim sum.", "changes": "很 → 好, 喜歡 → 鍾意, 吃 → 食" },
    { "written": "你說甚麼？", "spoken": [["你", "nei5"], ["講", "gong2"], ["乜嘢", "mat1 je5"], ["呀", "aa3"], ["？"]], "en": "What did you say?", "changes": "說 → 講, 甚麼 → 乜嘢" },
    { "written": "那裏有很多人。", "spoken": [["嗰度", "go2 dou6"], ["有", "jau5"], ["好", "hou2"], ["多", "do1"], ["人", "jan4"], ["。"]], "en": "There are lots of people there.", "changes": "那裏 → 嗰度, 很 → 好" },
    { "written": "他們去了哪裏？", "spoken": [["佢哋", "keoi5 dei6"], ["去", "heoi3"], ["咗", "zo2"], ["邊度", "bin1 dou6"], ["呀", "aa3"], ["？"]], "en": "Where did they go?", "changes": "他們 → 佢哋, 了 → 咗, 哪裏 → 邊度" },
    { "written": "不要擔心。", "spoken": [["唔好", "m4 hou2"], ["擔心", "daam1 sam1"], ["。"]], "en": "Don't worry.", "changes": "不要 → 唔好" },
    { "written": "我已經吃飽了。", "spoken": [["我", "ngo5"], ["已經", "ji5 ging1"], ["食", "sik6"], ["飽", "baau2"], ["喇", "laa3"], ["。"]], "en": "I'm already full.", "changes": "吃 → 食, sentence-final 了 → 喇" },
    { "written": "我的手機沒有電了。", "spoken": [["我", "ngo5"], ["部", "bou6"], ["手機", "sau2 gei1"], ["冇", "mou5"], ["電", "din6"], ["喇", "laa3"], ["。"]], "en": "My phone's battery is dead.", "changes": "我的 → 我部 (classifier), 沒有 → 冇, 了 → 喇" },
    { "written": "他被老闆罵了。", "spoken": [["佢", "keoi5"], ["畀", "bei2"], ["老細", "lou5 sai3"], ["鬧", "naau6"], ["咗", "zo2"], ["。"]], "en": "He got told off by his boss.", "changes": "他 → 佢, 被 → 畀, 老闆 → 老細, 罵 → 鬧, 了 → 咗" },
    { "written": "這裏不可以吸煙。", "spoken": [["呢度", "ni1 dou6"], ["唔", "m4"], ["可以", "ho2 ji5"], ["食煙", "sik6 jin1"], ["。"]], "en": "You can't smoke here.", "changes": "這裏 → 呢度, 不 → 唔, 吸煙 → 食煙" },
    {
      "written": "如果明天下雨，我們就不去。",
      "spoken": [["如果", "jyu4 gwo2"], ["聽日", "ting1 jat6"], ["落雨", "lok6 jyu5"], ["，"], ["我哋", "ngo5 dei6"], ["就", "zau6"], ["唔", "m4"], ["去", "heoi3"], ["。"]],
      "en": "If it rains tomorrow, we won't go.",
      "changes": "明天 → 聽日, 下雨 → 落雨, 我們 → 我哋, 不 → 唔"
    },
    { "written": "他說今天不來。", "spoken": [["佢", "keoi5"], ["話", "waa6"], ["今日", "gam1 jat6"], ["唔", "m4"], ["嚟", "lai4"], ["。"]], "en": "He said he isn't coming today.", "changes": "說 → 話, 今天 → 今日, 不來 → 唔嚟" },
    { "written": "東西都賣完了。", "spoken": [["啲", "di1"], ["嘢", "je5"], ["賣", "maai6"], ["晒", "saai3"], ["喇", "laa3"], ["。"]], "en": "Everything's sold out.", "changes": "東西 → 嘢, 都…完了 → 晒…喇" },
    { "written": "你喜歡哪一個？", "spoken": [["你", "nei5"], ["鍾意", "zung1 ji3"], ["邊", "bin1"], ["個", "go3"], ["呀", "aa3"], ["？"]], "en": "Which one do you like?", "changes": "喜歡 → 鍾意, 哪 → 邊" }
  ],
  "review": { "status": "draft", "reviewers": [] }
}
