[
  {
    "id": "hai6-copula",
    "pattern": "Subject + 係 + Noun",
    "jyutping": "Subject + hai6 + Noun",
    "meaning": "to be (identity)",
    "level": "A1",
    "function": "being-and-having",
    "explanation": "係 links a subject to a noun: who or what something is. It is not used before adjectives — say 佢好高 (he is tall), not 佢係高. To negate, use 唔係.",
    "writtenEquivalent": { "cjk": "是", "note": "Written Chinese uses 是; in speech always say 係." },
    "examples": [
      { "words": [["我", "ngo5"], ["係", "hai6"], ["學生", "hok6 saang1"], ["。"]], "en": "I'm a student.", "gap": { "word": "係", "distractors": ["喺", "有", "嘅"] } },
      { "words": [["佢", "keoi5"], ["係", "hai6"], ["我", "ngo5"], ["朋友", "pang4 jau5"], ["。"]], "en": "He's my friend.", "gap": { "word": "係", "distractors": ["喺", "冇", "嘅"] } },
      { "words": [["呢度", "ni1 dou6"], ["係", "hai6"], ["銅鑼灣", "tung4 lo4 waan1"], ["。"]], "en": "This is Causeway Bay.", "gap": { "word": "係", "distractors": ["喺", "有", "咗"] } }
    ],
    "mistakes": [{ "incorrect": "他是學生。", "correct": [["佢", "keoi5"], ["係", "hai6"], ["學生", "hok6 saang1"], ["。"]], "note": "他 and 是 are written forms. Speech uses 佢 and 係." }],
    "related": ["m4-negation", "hai2-location"],
    "review": { "status": "draft", "reviewers": [] }
  },
  {
    "id": "m4-negation",
    "pattern": "唔 + Verb / Adjective",
    "jyutping": "m4 + Verb / Adjective",
    "meaning": "not",
    "level": "A1",
    "function": "negation",
    "explanation": "Put 唔 directly before a verb or adjective to negate it. The one big exception is 有 (to have): its negative is 冇, never 唔有.",
    "writtenEquivalent": { "cjk": "不", "note": "Written Chinese uses 不; in speech always say 唔." },
    "examples": [
      { "words": [["我", "ngo5"], ["唔", "m4"], ["食", "sik6"], ["牛肉", "ngau4 juk6"], ["。"]], "en": "I don't eat beef.", "gap": { "word": "唔", "distractors": ["冇", "咗", "好"] } },
      { "words": [["今日", "gam1 jat6"], ["唔", "m4"], ["熱", "jit6"], ["。"]], "en": "It's not hot today.", "gap": { "word": "唔", "distractors": ["好", "太", "咗"] } },
      { "words": [["佢", "keoi5"], ["唔", "m4"], ["係", "hai6"], ["老師", "lou5 si1"], ["。"]], "en": "She isn't a teacher.", "gap": { "word": "唔", "distractors": ["冇", "都", "未"] } }
    ],
    "mistakes": [{ "incorrect": "我不去。", "correct": [["我", "ngo5"], ["唔", "m4"], ["去", "heoi3"], ["。"]], "note": "不 is written Chinese. Say 唔." }],
    "related": ["jau5-mou5", "hai6-copula"],
    "review": { "status": "draft", "reviewers": [] }
  },
  {
    "id": "jau5-mou5",
