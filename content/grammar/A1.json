      { "words": [["佢", "keoi5"], ["返", "faan1"], ["咗", "zo2"], ["屋企", "uk1 kei2"], ["。"]], "en": "He's gone home.", "gap": { "word": "咗", "distractors": ["緊", "過", "吓"] } },
      { "words": [["我", "ngo5"], ["買", "maai5"], ["咗", "zo2"], ["兩", "loeng5"], ["本", "bun2"], ["書", "syu1"], ["。"]], "en": "I bought two books.", "gap": { "word": "咗", "distractors": ["緊", "過", "吓"] } }
    ],
    "mistakes": [{ "incorrect": "我吃了飯。", "correct": [["我", "ngo5"], ["食", "sik6"], ["咗", "zo2"], ["飯", "faan6"], ["。"]], "note": "吃 and 了 are written forms. Speech uses 食 and 咗." }],
    "related": ["mei6-yet", "gan2-progressive", "gwo3-experience"],
    "review": { "status": "draft", "reviewers": [] }
  },
