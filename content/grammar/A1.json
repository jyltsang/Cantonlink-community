      { "words": [["佢", "keoi5"], ["嘅", "ge3"], ["電話", "din6 waa2"], ["號碼", "hou6 maa5"], ["係", "hai6"], ["幾多", "gei2 do1"], ["呀", "aa3"], ["？"]], "en": "What's her phone number?", "gap": { "word": "嘅", "distractors": ["緊", "喺", "咗"] } },
      {
        "words": [["我", "ngo5"], ["知道", "zi1 dou3"], ["一", "jat1"], ["間", "gaan1"], ["好好食", "hou2 hou2 sik6"], ["嘅", "ge3"], ["餐廳", "caan1 teng1"], ["。"]],
