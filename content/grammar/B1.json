      {
        "words": [["佢", "keoi5"], ["講", "gong2"], ["廣東話", "gwong2 dung1 waa2"], ["講", "gong2"], ["得", "dak1"], ["好", "hou2"], ["好", "hou2"], ["。"]],
        "en": "She speaks Cantonese really well.",
        "gap": { "word": "得", "distractors": ["咗", "緊", "嘅"] }
      },
      { "words": [["你", "nei5"], ["寫", "se2"], ["字", "zi6"], ["寫", "se2"], ["得", "dak1"], ["好", "hou2"], ["靚", "leng3"], ["。"]], "en": "Your handwriting is beautiful.", "gap": { "word": "得", "distractors": ["咗", "緊", "嘅"] } },
      { "words": [["佢", "keoi5"], ["行", "haang4"], ["得", "dak1"], ["好", "hou2"], ["慢", "maan6"], ["。"]], "en": "He walks very slowly.", "gap": { "word": "得", "distractors": ["咗", "緊", "嘅"] } }
    ],
    "related": ["dou2-result", "taai3-too"],
    "review": { "status": "draft", "reviewers": [] }
  },
