  {
    "id": "dou2-result",
    "pattern": "Verb + 到 / Verb + 唔到",
    "jyutping": "Verb + dou2 / Verb + m4 dou2",
    "meaning": "manage to; can't manage to",
    "level": "B1",
    "function": "complements",
    "explanation": "到 (dou2, rising tone) after a verb says the action succeeded: 搵到 (found), 買到 (managed to buy). Put 唔 in between for 'couldn't': 買唔到. This is a different word from dou3 'to arrive', which is written with the same character.",
    "examples": [
      { "words": [["我", "ngo5"], ["搵", "wan2"], ["到", "dou2"], ["我", "ngo5"], ["條", "tiu4"], ["鎖匙", "so2 si4"], ["喇", "laa3"], ["。"]], "en": "I've found my key.", "gap": { "word": "到", "distractors": ["完", "緊", "過"] } },
      { "words": [["你", "nei5"], ["聽唔聽到", "teng1 m4 teng1 dou2"], ["呀", "aa3"], ["？"]], "en": "Can you hear me?" },
      { "words": [["佢", "keoi5"], ["買", "maai5"], ["唔", "m4"], ["到", "dou2"], ["飛", "fei1"], ["。"]], "en": "He couldn't get a ticket.", "gap": { "word": "到", "distractors": ["完", "緊", "過"] } }
    ],
    "related": ["dak1-degree", "jyun4-finish"],
    "review": { "status": "draft", "reviewers": [] }
  },
  {
    "id": "dak1-degree",
    "pattern": "Verb + 得 + Adjective",
    "jyutping": "Verb + dak1 + Adjective",
    "meaning": "how well / how fast someone does something",
    "level": "B1",
    "function": "complements",
    "explanation": "To describe how an action is done, put 得 after the verb and then the description: 行得好慢 (walks slowly). If the verb has an object, say the verb twice: 講廣東話講得好好.",
