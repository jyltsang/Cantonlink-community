[
  {
    "id": "mei6-yet",
    "pattern": "Verb + 咗 + … 未？ / 未 + Verb",
    "jyutping": "Verb + zo2 + … mei6? / mei6 + Verb",
    "meaning": "…yet? / not yet",
    "level": "A2",
    "function": "aspect",
    "explanation": "Put 未 at the end of a 咗 sentence to ask 'yet?'. Answer …咗喇 (yes, already) or 未呀 (not yet). Before a verb, 未 means 'haven't yet'. 食咗飯未呀？ is also an everyday greeting.",
    "writtenEquivalent": { "cjk": "…了沒有？ / 還沒", "note": "Written Chinese uses 了沒有 and 還沒." },
    "examples": [
      { "words": [["你", "nei5"], ["食", "sik6"], ["咗", "zo2"], ["飯", "faan6"], ["未", "mei6"], ["呀", "aa3"], ["？"]], "en": "Have you eaten yet?", "gap": { "word": "未", "distractors": ["唔", "冇", "都"] } },
      { "words": [["佢", "keoi5"], ["到", "dou3"], ["咗", "zo2"], ["未", "mei6"], ["呀", "aa3"], ["？"]], "en": "Has he arrived yet?", "gap": { "word": "未", "distractors": ["唔", "冇", "都"] } },
      { "words": [["我", "ngo5"], ["未", "mei6"], ["食", "sik6"], ["。"]], "en": "I haven't eaten yet.", "gap": { "word": "未", "distractors": ["唔", "都", "好"] } }
    ],
    "related": ["zo2-completed", "gwo3-experience"],
    "review": { "status": "draft", "reviewers": [] }
  },
